# Frontend
VITE_API_URL=http://127.0.0.1:3001
VITE_SOCKET_URL=http://127.0.0.1:3001
VITE_MODEL_PATH=./models

# Backend
NODE_ENV=development
PORT=3001
WORKSPACE_ROOT=./workspace
MODELS_PATH=./models
DATABASE_URL=file:./backend/.freebuff/state.db

# Llama.cpp
LLAMA_URL=http://127.0.0.1:8080
LLAMA_PORT=8080
LLAMA_GPU=false
LLAMA_THREADS=4

# ChromaDB
CHROMADB_PATH=./chromadb
CHROMADB_PORT=8000

# Logging
LOG_LEVEL=debug
LOG_FILE=./backend/logs/freebuff.log

# Security
SECURITY_SANDBOX=true
SECURITY_AUDIT=true
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=js,ts,jsx,tsx,py,go,rs,java,c,cpp,cs,json,yaml,yml,md,html,css,scss

# AI
DEFAULT_MODEL=llama-3.1-8b-gguf
DEFAULT_CHAT_MODEL=coder-8b-q4
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
AI_CONTEXT_WINDOW=4096
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# Job Engine
JOB_QUEUE_WORKERS=4
JOB_TIMEOUT_DEFAULT=300000
JOB_MAX_RETRIES=3

# Performance
PERF_ENABLE_METRICS=true
PERF_SAMPLE_RATE=0.1
